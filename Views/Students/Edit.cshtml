@model Student
@{ ViewData["Title"] = "Edit student"; }
<div class="form-page"><a asp-action="Index" class="back-link">← Back to students</a><div class="form-header"><div class="eyebrow">STUDENT DIRECTORY · @Model.StudentNumber</div><h1>Edit student</h1><p class="page-subtitle">Update @Model.Name's profile details.</p></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="student-form"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section-title">Personal information</div><div class="form-grid"><div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="field"><label asp-for="StudentNumber"></label><input asp-for="StudentNumber" /><span asp-validation-for="StudentNumber" class="field-error"></span></div><div class="field"><label asp-for="Department"></label><input asp-for="Department" /><span asp-validation-for="Department" class="field-error"></span></div><div class="field"><label asp-for="Marks"></label><div class="input-suffix"><input asp-for="Marks" step="0.01" /><span>%</span></div><span asp-validation-for="Marks" class="field-error"></span></div><div class="field"><label asp-for="Status"></label><select asp-for="Status"><option>Active</option><option>Inactive</option></select><span asp-validation-for="Status" class="field-error"></span></div><div class="field"><label asp-for="EnrollmentDate"></label><input asp-for="EnrollmentDate" /><span asp-validation-for="EnrollmentDate" class="field-error"></span></div></div><div class="form-actions"><a asp-action="Index" class="button button-outline">Cancel</a><button class="button button-primary" type="submit">Save changes</button></div></form></div>
