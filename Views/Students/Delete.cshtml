@model Student
@{ ViewData["Title"] = "Remove student"; }
<div class="form-page"><a asp-action="Index" class="back-link">← Back to students</a><section class="delete-card"><div class="delete-icon">!</div><h1>Remove this student?</h1><p>This will permanently remove the profile and its details from your student directory.</p><div class="delete-student"><div class="avatar student-avatar tone-@(Model.Id % 5)">@string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpper()</div><div><strong>@Model.Name</strong><span>@Model.StudentNumber · @Model.Department</span></div></div><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><a asp-action="Index" class="button button-outline">Cancel</a><button type="submit" class="button button-danger">Remove student</button></form></section></div>
