@model IReadOnlyList<Student>
@{ ViewData["Title"] = "Students"; var page = (int)ViewBag.Page; var pages = (int)ViewBag.Pages; }
<div class="page-heading"><div><div class="eyebrow">PEOPLE <span>·</span> DIRECTORY</div><h1>Students <span class="heading-count">@ViewBag.Total</span></h1><p class="page-subtitle">Manage your students and keep everything in one place.</p></div><a asp-action="Create" class="button button-primary"><span class="plus">+</span> Add student</a></div>
<section class="stats-grid">
    <article class="stat-card"><div class="stat-top"><span>Total students</span><span class="stat-icon blue">♙</span></div><div class="stat-number">@ViewBag.Total</div><div class="stat-note"><span class="trend">↗</span> Your student body</div></article>
    <article class="stat-card"><div class="stat-top"><span>Active students</span><span class="stat-icon green">◉</span></div><div class="stat-number">@ViewBag.Active</div><div class="stat-note"><span class="status-dot"></span> Currently enrolled</div></article>
    <article class="stat-card"><div class="stat-top"><span>Average marks</span><span class="stat-icon violet">⌁</span></div><div class="stat-number">@(((double)ViewBag.Average).ToString("0.0"))<small>%</small></div><div class="stat-note">Across all students</div></article>
    <article class="stat-card term-stat"><div class="stat-top"><span>Current term</span><span class="stat-icon amber">◷</span></div><div class="stat-number term-number">Fall 2025</div><div class="stat-note">Aug 25 — Dec 19, 2025</div></article>
</section>
<section class="directory-card">
    <div class="directory-heading"><div><h2>All students</h2><p>A complete list of everyone in your school.</p></div><div class="table-actions"><button class="button button-outline export-button" type="button" onclick="window.print()"><span>⇩</span> Export</button></div></div>
    <form method="get" asp-action="Index" class="filter-bar"><label class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Search by name, email or ID..." /><kbd>⌘ K</kbd></label><label class="select-wrap"><select name="department" onchange="this.form.submit()"><option value="">All departments</option>@foreach (string dep in (IEnumerable<string>)ViewBag.Departments) { <option selected="@(dep == (string?)ViewBag.Department ? "selected" : null)" value="@dep">@dep</option> }</select><span>⌄</span></label><label class="select-wrap"><select name="status" onchange="this.form.submit()"><option value="">Any status</option><option value="Active" selected="@("Active" == (string?)ViewBag.Status ? "selected" : null)">Active</option><option value="Inactive" selected="@("Inactive" == (string?)ViewBag.Status ? "selected" : null)">Inactive</option></select><span>⌄</span></label><button class="button button-light filter-button" type="submit">Filter</button></form>
    <div class="table-wrap"><table><thead><tr><th><input aria-label="Select all" type="checkbox" class="checkbox" /></th><th>STUDENT <span class="sort">↕</span></th><th>STUDENT ID</th><th>DEPARTMENT</th><th>MARKS <span class="sort">↕</span></th><th>STATUS</th><th>ENROLLED</th><th></th></tr></thead><tbody>
    @if (Model.Count == 0) { <tr><td colspan="8"><div class="empty-state"><span>⌕</span><strong>No students found</strong><p>Try adjusting your filters or add a student.</p><a asp-action="Create" class="button button-primary">Add student</a></div></td></tr> }
    @foreach (var student in Model) { var initials = string.Join("", student.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpper(); <tr><td><input aria-label="Select @student.Name" type="checkbox" class="checkbox" /></td><td><div class="student-cell"><div class="avatar student-avatar tone-@(student.Id % 5)">@initials</div><div><strong>@student.Name</strong><span>@student.Email</span></div></div></td><td><span class="student-number">@student.StudentNumber</span></td><td><span class="department-chip">@student.Department</span></td><td><div class="marks-cell"><div class="progress-track"><i style="width:@student.Marks.ToString("0")%"></i></div><span>@student.Marks.ToString("0")%</span></div></td><td><span class="badge @(student.Status == "Active" ? "badge-active" : "badge-inactive")"><i></i>@student.Status</span></td><td class="date-cell">@student.EnrollmentDate.ToString("MMM d, yyyy")</td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@student.Id" aria-label="Edit @student.Name" title="Edit student">✎</a><a asp-action="Delete" asp-route-id="@student.Id" aria-label="Delete @student.Name" title="Delete student" class="delete-action">⌫</a></div></td></tr> }
    </tbody></table></div>
    <div class="table-footer"><span>Showing <strong>@(ViewBag.Filtered == 0 ? 0 : (page - 1) * 8 + 1)–@Math.Min(page * 8, (int)ViewBag.Filtered)</strong> of <strong>@ViewBag.Filtered</strong> students</span><div class="pagination"><a class="@(page <= 1 ? "disabled" : "")" asp-route-page="@(page - 1)" asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.Department" asp-route-status="@ViewBag.Status">← <span>Previous</span></a>@for (var p = 1; p <= pages; p++) { <a class="@(p == page ? "current" : "")" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.Department" asp-route-status="@ViewBag.Status">@p</a> }<a class="@(page >= pages ? "disabled" : "")" asp-route-page="@(page + 1)" asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.Department" asp-route-status="@ViewBag.Status"><span>Next</span> →</a></div></div>
</section>
