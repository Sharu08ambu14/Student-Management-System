<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Campusly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="Students" asp-action="Index"><span class="brand-mark">c</span><span>campusly<span class="brand-dot">.</span></span></a>
        <div class="workspace-label">WORKSPACE</div>
        <a class="nav-link active" asp-controller="Students" asp-action="Index"><span class="nav-icon">▦</span> Students <span class="nav-count">01</span></a>
        <div class="sidebar-spacer"></div>
        <div class="help-card"><div class="help-icon">✦</div><strong>Need a hand?</strong><p>Find answers in our help center.</p><a href="mailto:support@campusly.school">Visit help center <span>↗</span></a></div>
        <div class="profile"><div class="avatar admin-avatar">JD</div><div class="profile-copy"><strong>Jamie Davis</strong><span>Administrator</span></div><button class="more-button" aria-label="More options">···</button></div>
    </aside>
    <main class="main-area">
        <header class="topbar"><div class="breadcrumbs"><span>Workspace</span><span class="crumb-slash">/</span><strong>Students</strong></div><div class="topbar-right"><span class="term-pill"><i></i> Fall semester 2025</span><button class="icon-button" aria-label="Notifications">♧<b></b></button><div class="avatar admin-avatar small">JD</div></div></header>
        @if (TempData["Success"] is string success) { <div class="toast-message">✓ &nbsp;@success</div> }
        <div class="page-content">@RenderBody()</div>
        <footer class="footer"><span>© 2025 Campusly</span><span>Made for better learning <span class="heart">♥</span></span><a href="mailto:support@campusly.school">Help & support</a></footer>
    </main>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
